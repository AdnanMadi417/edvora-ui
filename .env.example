# ── Application ───────────────────────────────────────────────────────────────
AUTH_SECRET_KEY=
NEXT_PUBLIC_API_URL=https://staging-backend-l9en3.ondigitalocean.app
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_ENVIRONMENT=staging   # staging | production

# ── Feature flags ─────────────────────────────────────────────────────────────
# Unset or anything other than "true" = feature OFF (nav entry hidden, route
# blocked). Inlined at build time, so flipping one needs a rebuild.
NEXT_PUBLIC_ENABLE_PARTNER_PUBLIC_PROFILE=false   # /partner/public-profile + /p/[slug]
NEXT_PUBLIC_ENABLE_PARTNER_UNIVERSITIES=false     # /partner/universities

# ── OpenTelemetry / SigNoz Cloud ──────────────────────────────────────────────
# Set SIGNOZ_ENDPOINT to enable telemetry. Leave blank to disable entirely.
SIGNOZ_ENDPOINT=https://ingest.us.signoz.cloud:443
SIGNOZ_INGESTION_KEY=your-signoz-ingestion-key
SIGNOZ_SERVICE_NAME=unibexs-frontend
